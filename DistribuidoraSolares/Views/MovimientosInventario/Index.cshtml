@model List<DistribuidoraSolares.Models.InventarioMovimiento>
@{
    ViewData["Title"] = "Movimientos de Inventario";
    var productos = ViewBag.Productos as List<DistribuidoraSolares.Models.Producto> ?? new List<DistribuidoraSolares.Models.Producto>();
    var sucursales = ViewBag.Sucursales as List<DistribuidoraSolares.Models.Sucursal> ?? new List<DistribuidoraSolares.Models.Sucursal>();
    var esSuperAdmin = ViewBag.EsSuperAdmin as bool? ?? false;
    var paginacion = ViewBag.Paginacion as DistribuidoraSolares.Helpers.PaginacionResult<DistribuidoraSolares.Models.InventarioMovimiento>;
    var totalCompras = ViewBag.TotalCompras as decimal? ?? 0;
    var totalVentas = ViewBag.TotalVentas as decimal? ?? 0;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Movimientos de Inventario</h1>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Resumen de Totales -->
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Compras</h5>
                    <h3>Q@(totalCompras.ToString("N2"))</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Ventas</h5>
                    <h3>Q@(totalVentas.ToString("N2"))</h3>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Index" method="get" class="mb-3">
        <input type="hidden" name="pagina" value="1" />
        <div class="row g-3">
            @if (esSuperAdmin)
            {
                <div class="col-md-3">
                    <label class="form-label">Sucursal</label>
                    <select name="sucursalIdFiltro" class="form-select">
                        <option value="">Seleccione sucursal</option>
                        @foreach (var sucursal in sucursales)
                        {
                            <option value="@sucursal.SucursalId" selected="@(ViewBag.SucursalIdFiltro == sucursal.SucursalId)">
                                @sucursal.Nombre
                            </option>
                        }
                    </select>
                    <small class="text-muted">Debe seleccionar una sucursal para ver movimientos</small>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label">Producto</label>
                <select name="productoId" class="form-select">
                    <option value="">Todos los productos</option>
                    @foreach (var producto in productos)
                    {
                        <option value="@producto.ProductoId" selected="@(ViewBag.ProductoId == producto.ProductoId)">
                            @producto.Nombre (@producto.Codigo)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Buscar</label>
                <input type="text" name="buscar" class="form-control" placeholder="Buscar movimientos..." value="@ViewBag.Buscar">
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit">Buscar</button>
            </div>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <p>No hay movimientos de inventario registrados.</p>
        </div>
    }
    else
    {
        <!-- Información de paginación -->
        @if (paginacion != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <small class="text-muted">
                        Mostrando @((paginacion.PaginaActual - 1) * paginacion.TamañoPagina + 1) - 
                        @(Math.Min(paginacion.PaginaActual * paginacion.TamañoPagina, paginacion.TotalItems)) 
                        de @paginacion.TotalItems movimientos
                    </small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0">Resultados por página:</label>
                    <select id="tamañoPaginaSelect" class="form-select form-select-sm" style="width: auto;">
                        <option value="10" selected="@(paginacion.TamañoPagina == 10)">10</option>
                        <option value="20" selected="@(paginacion.TamañoPagina == 20)">20</option>
                        <option value="50" selected="@(paginacion.TamañoPagina == 50)">50</option>
                        <option value="100" selected="@(paginacion.TamañoPagina == 100)">100</option>
                    </select>
                </div>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha/Hora</th>
                        <th>Producto</th>
                        <th>Tipo</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Costo Unitario</th>
                        <th class="text-end">Costo Total</th>
                        <th>Referencia</th>
                        <th>Descripción</th>
                        <th>Usuario</th>
                        @if (esSuperAdmin)
                        {
                            <th>Sucursal</th>
                        }
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movimiento in Model)
                    {
                        var costoTotal = movimiento.CostoUnitario.HasValue 
                            ? Math.Abs(movimiento.Cantidad) * movimiento.CostoUnitario.Value 
                            : 0;
                        
                        <tr>
                            <td>@movimiento.FechaHora.ToString("g")</td>
                            <td>@(movimiento.Producto?.Nombre ?? $"Producto ID: {movimiento.ProductoId}")</td>
                            <td>
                                <span class="badge @(movimiento.Tipo == "COMPRA" ? "bg-success" : movimiento.Tipo == "VENTA" ? "bg-danger" : movimiento.Tipo == "RESERVA" ? "bg-warning" : "bg-info")">
                                    @movimiento.Tipo
                                </span>
                            </td>
                            <td class="text-end">@movimiento.Cantidad</td>
                            <td class="text-end">@(movimiento.CostoUnitario.HasValue ? $"Q{movimiento.CostoUnitario.Value:N2}" : "-")</td>
                            <td class="text-end"><strong>@(costoTotal > 0 ? $"Q{costoTotal:N2}" : "-")</strong></td>
                            <td>
                                @if (movimiento.CompraId.HasValue)
                                {
                                    <span>Compra #@movimiento.CompraId</span>
                                }
                                else if (movimiento.VentaId.HasValue)
                                {
                                    <span>Venta #@movimiento.VentaId</span>
                                }
                                else if (movimiento.ReservaId.HasValue)
                                {
                                    <span>Reserva #@movimiento.ReservaId</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>@(movimiento.Descripcion ?? "-")</td>
                            <td>@(movimiento.Usuario?.Nombre ?? "N/A")</td>
                            @if (esSuperAdmin)
                            {
                                <td>@(movimiento.Sucursal?.Nombre ?? "Sin sucursal")</td>
                            }
                            <td>
                                <span class="badge @(movimiento.Estado == "ACTIVO" ? "bg-success" : "bg-secondary")">
                                    @movimiento.Estado
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        @if (paginacion != null && paginacion.TotalPaginas > 1)
        {
            <nav aria-label="Paginación de movimientos">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(!paginacion.TienePaginaAnterior ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            buscar = ViewBag.Buscar, 
                            productoId = ViewBag.ProductoId, 
                            sucursalIdFiltro = ViewBag.SucursalIdFiltro,
                            pagina = paginacion.PaginaActual - 1, 
                            tamañoPagina = paginacion.TamañoPagina 
                        })">Anterior</a>
                    </li>
                    @for (int i = 1; i <= paginacion.TotalPaginas; i++)
                    {
                        if (i == paginacion.PaginaActual || i == 1 || i == paginacion.TotalPaginas || (i >= paginacion.PaginaActual - 2 && i <= paginacion.PaginaActual + 2))
                        {
                            <li class="page-item @(i == paginacion.PaginaActual ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { 
                                    buscar = ViewBag.Buscar, 
                                    productoId = ViewBag.ProductoId, 
                                    sucursalIdFiltro = ViewBag.SucursalIdFiltro,
                                    pagina = i, 
                                    tamañoPagina = paginacion.TamañoPagina 
                                })">@i</a>
                            </li>
                        }
                        else if (i == paginacion.PaginaActual - 3 || i == paginacion.PaginaActual + 3)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }
                    <li class="page-item @(!paginacion.TienePaginaSiguiente ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { 
                            buscar = ViewBag.Buscar, 
                            productoId = ViewBag.ProductoId, 
                            sucursalIdFiltro = ViewBag.SucursalIdFiltro,
                            pagina = paginacion.PaginaActual + 1, 
                            tamañoPagina = paginacion.TamañoPagina 
                        })">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script>
        // Cambiar tamaño de página
        document.getElementById('tamañoPaginaSelect')?.addEventListener('change', function() {
            const tamañoPagina = this.value;
            const url = new URL(window.location.href);
            url.searchParams.set('tamañoPagina', tamañoPagina);
            url.searchParams.set('pagina', '1');
            window.location.href = url.toString();
        });
    </script>
}
