@model List<DistribuidoraSolares.Models.Sucursal>
@{
    ViewData["Title"] = "Sucursales";
    var esSuperAdmin = ViewBag.EsSuperAdmin as bool? ?? false;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Sucursales</h1>
        @if (esSuperAdmin)
        {
            <a asp-action="Create" class="btn btn-primary">Nueva Sucursal</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="buscar" class="form-control" placeholder="Buscar sucursales..." value="@ViewBag.Buscar">
            <button class="btn btn-outline-secondary" type="submit">Buscar</button>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <p>No hay sucursales registradas.</p>
        </div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Código</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th>Fecha Creación</th>
                    @if (esSuperAdmin)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var sucursal in Model)
                {
                    <tr>
                        <td>@sucursal.SucursalId</td>
                        <td>@sucursal.Nombre</td>
                        <td>@(sucursal.Codigo ?? "-")</td>
                        <td>@(sucursal.Direccion ?? "-")</td>
                        <td>@(sucursal.Telefono ?? "-")</td>
                        <td>
                            @if (sucursal.Estado == "ACTIVO")
                            {
                                <span class="badge bg-success">@sucursal.Estado</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@sucursal.Estado</span>
                            }
                        </td>
                        <td>@sucursal.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                        @if (esSuperAdmin)
                        {
                            <td>
                                <a asp-action="Edit" asp-route-id="@sucursal.SucursalId" class="btn btn-sm btn-warning">Editar</a>
                                <form asp-action="Delete" asp-route-id="@sucursal.SucursalId" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de que desea eliminar esta sucursal?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<script>
    // Ocultar alertas después de 5 segundos
    setTimeout(function() {
        var alerts = document.querySelectorAll('.alert');
        alerts.forEach(function(alert) {
            var bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        });
    }, 5000);
</script>
