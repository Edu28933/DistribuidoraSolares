@model DistribuidoraSolares.Models.Sucursal
@{
    ViewData["Title"] = "Nueva Sucursal";
}

<div class="container">
    <h1>Nueva Sucursal</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
            <input asp-for="Nombre" class="form-control" required placeholder="Ej: Tienda 1" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
            <small class="form-text text-muted">Nombre de la sucursal (ej: Tienda 1, Tienda 2, etc.)</small>
        </div>

        <div class="mb-3">
            <label asp-for="Codigo" class="form-label">Código</label>
            <input asp-for="Codigo" class="form-control" placeholder="Ej: TIENDA001" maxlength="20" />
            <span asp-validation-for="Codigo" class="text-danger"></span>
            <small class="form-text text-muted">Código único de la sucursal (opcional)</small>
        </div>

        <div class="mb-3">
            <label asp-for="Direccion" class="form-label">Dirección</label>
            <input asp-for="Direccion" class="form-control" placeholder="Dirección de la sucursal" maxlength="255" />
            <span asp-validation-for="Direccion" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Telefono" class="form-label">Teléfono</label>
            <input asp-for="Telefono" class="form-control" placeholder="Teléfono de contacto" maxlength="30" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Estado" class="form-label">Estado</label>
            <select asp-for="Estado" class="form-select">
                <option value="ACTIVO">ACTIVO</option>
                <option value="INACTIVO">INACTIVO</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
