@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    <h1 class="mb-4">Dashboard</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5>Estado de Caja</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.CajaAbierta != null)
                    {
                        var caja = ViewBag.CajaAbierta as DistribuidoraSolares.Models.Caja;
                        <p class="text-success"><strong>Caja Abierta</strong></p>
                        <p>ID: @caja.CajaId</p>
                        <p>Saldo Inicial: Q@(caja.SaldoInicial.ToString("N2"))</p>
                        <p>Fecha Apertura: @caja.FechaApertura.ToString("g")</p>
                        <a asp-controller="Caja" asp-action="Index" class="btn btn-primary">Ver Detalles</a>
                    }
                    else
                    {
                        <p class="text-danger"><strong>Caja Cerrada</strong></p>
                        <a asp-controller="Caja" asp-action="Abrir" class="btn btn-success">Abrir Caja</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5>Productos con Stock Bajo</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.StockBajo != null && ((List<DistribuidoraSolares.Models.StockActual>)ViewBag.StockBajo).Any())
                    {
                        <ul class="list-group">
                            @foreach (var producto in (List<DistribuidoraSolares.Models.StockActual>)ViewBag.StockBajo)
                            {
                                <li class="list-group-item">
                                    <strong>@producto.Nombre</strong> - 
                                    Stock: @producto.Stock / Mínimo: @producto.StockMinimo
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-success">No hay productos con stock bajo</p>
                    }
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-primary mt-2">Ver Productos</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>Accesos Rápidos</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Ventas" asp-action="Create" class="btn btn-success w-100">Nueva Venta</a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Productos" asp-action="Create" class="btn btn-primary w-100">Nuevo Producto</a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Ventas" asp-action="Index" class="btn btn-info w-100">Ver Ventas</a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Caja" asp-action="Index" class="btn btn-warning w-100">Gestión de Caja</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>