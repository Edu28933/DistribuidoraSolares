@model DistribuidoraSolares.Models.Usuario
@{
    ViewData["Title"] = "Nuevo Usuario";
    var roles = ViewBag.Roles as List<DistribuidoraSolares.Models.Rol> ?? new List<DistribuidoraSolares.Models.Rol>();
    var sucursales = ViewBag.Sucursales as List<DistribuidoraSolares.Models.Sucursal> ?? new List<DistribuidoraSolares.Models.Sucursal>();
}

<div class="container">
    <h1>Nuevo Usuario</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" required />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UsuarioLogin" class="form-label">Usuario Login</label>
            <input asp-for="UsuarioLogin" class="form-control" required />
            <span asp-validation-for="UsuarioLogin" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Correo Electrónico</label>
            <input type="email" name="email" class="form-control" />
            <small class="form-text text-muted">Opcional: Para recuperación de contraseña</small>
        </div>

        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input type="password" name="password" class="form-control" required />
            <small class="form-text text-muted">La contraseña será encriptada automáticamente</small>
        </div>

        <div class="mb-3">
            <label asp-for="RolId" class="form-label">Rol</label>
            <select asp-for="RolId" class="form-select" required id="rolSelect" onchange="actualizarSucursalSelector()">
                <option value="">Seleccione un rol</option>
                @foreach (var rol in roles)
                {
                    <option value="@rol.RolId">@rol.Nombre</option>
                }
            </select>
            <span asp-validation-for="RolId" class="text-danger"></span>
        </div>

        <div class="mb-3" id="sucursalGroup">
            <label asp-for="SucursalId" class="form-label">Sucursal</label>
            <select asp-for="SucursalId" class="form-select">
                <option value="">Sin sucursal (SuperAdmin/Contador)</option>
                @foreach (var sucursal in sucursales)
                {
                    <option value="@sucursal.SucursalId">@sucursal.Nombre</option>
                }
            </select>
            <small class="form-text text-muted">SuperAdmin y Contador no requieren sucursal (ven todo). Admin y Vendedor deben tener sucursal asignada.</small>
        </div>

        <div class="mb-3">
            <label asp-for="Estado" class="form-label">Estado</label>
            <select asp-for="Estado" class="form-select">
                <option value="ACTIVO">ACTIVO</option>
                <option value="INACTIVO">INACTIVO</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

<script>
    function actualizarSucursalSelector() {
        var rolSelect = document.getElementById('rolSelect');
        var sucursalGroup = document.getElementById('sucursalGroup');
        var sucursalSelect = document.querySelector('select[name="SucursalId"]');
        var rolNombre = rolSelect.options[rolSelect.selectedIndex].text.toUpperCase();
        
        // Si es SuperAdmin o Contador, ocultar o hacer opcional la sucursal
        if (rolNombre.includes('SUPERADMIN') || rolNombre.includes('CONTADOR')) {
            sucursalGroup.style.display = 'block';
            sucursalSelect.required = false;
            sucursalSelect.value = ''; // Limpiar selección
        } else {
            // Admin y Vendedor requieren sucursal
            sucursalGroup.style.display = 'block';
            sucursalSelect.required = true;
        }
    }
    
    // Ejecutar al cargar la página
    document.addEventListener('DOMContentLoaded', function() {
        actualizarSucursalSelector();
    });
</script>
