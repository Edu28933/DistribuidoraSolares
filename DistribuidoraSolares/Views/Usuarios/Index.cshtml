@model List<DistribuidoraSolares.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
    var esSuperAdmin = ViewBag.EsSuperAdmin as bool? ?? false;
    var esAdmin = ViewBag.EsAdmin as bool? ?? false;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Usuarios</h1>
        @if (esSuperAdmin)
        {
            <a asp-action="Create" class="btn btn-primary">Nuevo Usuario</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group">
            <input type="text" name="buscar" class="form-control" placeholder="Buscar usuarios..." value="@ViewBag.Buscar">
            <button class="btn btn-outline-secondary" type="submit">Buscar</button>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <p>No hay usuarios activos registrados.</p>
        </div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Usuario Login</th>
                    <th>Rol</th>
                    <th>Sucursal</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@usuario.UsuarioId</td>
                        <td>@usuario.Nombre</td>
                        <td>@usuario.UsuarioLogin</td>
                        <td>@(usuario.Rol?.Nombre ?? $"Rol ID: {usuario.RolId}")</td>
                        <td>@(usuario.Sucursal?.Nombre ?? "Sin sucursal")</td>
                        <td>
                            <span class="badge bg-success">
                                @usuario.Estado
                            </span>
                        </td>
                        <td>
                            @if (esSuperAdmin || esAdmin || (usuario.UsuarioId == Context.Session.GetInt32("UsuarioId")))
                            {
                                <a asp-action="Edit" asp-route-id="@usuario.UsuarioId" class="btn btn-sm btn-warning">Ver/Editar</a>
                            }
                            @if (esSuperAdmin)
                            {
                                <form asp-action="Delete" asp-route-id="@usuario.UsuarioId" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar este usuario?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
