@{
    ViewData["Title"] = "Nueva Venta";
    var productos = ViewBag.Productos as List<DistribuidoraSolares.Models.Producto> ?? new List<DistribuidoraSolares.Models.Producto>();
    var clientes = ViewBag.Clientes as List<DistribuidoraSolares.Models.Cliente> ?? new List<DistribuidoraSolares.Models.Cliente>();
    var metodosPago = ViewBag.MetodosPago as List<DistribuidoraSolares.Models.MetodoPago> ?? new List<DistribuidoraSolares.Models.MetodoPago>();
    var stock = ViewBag.Stock as Dictionary<int, int> ?? new Dictionary<int, int>();
    var stockPorSucursal = ViewBag.StockPorSucursal as Dictionary<int, Dictionary<int, int>>;
    var esVendedor = ViewBag.EsVendedor as bool? ?? false;
    var sucursalIdUsuario = ViewBag.SucursalIdUsuario as int?;
}

<div class="container">
    <h1>Nueva Venta</h1>

    <form id="ventaForm" method="post">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Cliente (Opcional)</label>
                <select name="ClienteId" id="clienteSelect" class="form-select">
                    <option value="">Cliente General</option>
                    @foreach (var cliente in clientes)
                    {
                        <option value="@cliente.ClienteId">@cliente.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Método de Pago</label>
                <select name="MetodoPagoId" class="form-select" required>
                    <option value="">Seleccione método de pago</option>
                    @foreach (var metodo in metodosPago)
                    {
                        <option value="@metodo.MetodoPagoId">@metodo.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Tipo de Venta</label>
                <select name="TipoVenta" class="form-select" required>
                    <option value="NORMAL">Venta Normal</option>
                    <option value="PERDIDA">Pérdida</option>
                </select>
                <small class="form-text text-muted">Seleccione "Pérdida" para productos dañados o perdidos</small>
            </div>
        </div>

        <input type="hidden" name="UsuarioId" value="@ViewBag.UsuarioId" />
        <input type="hidden" name="DescuentoManual" value="0" />
        <input type="hidden" name="ReservaId" id="reservaIdHidden" value="" />

        <!-- Sección de Reservas Activas -->
        <div id="reservasSection" class="card mb-3" style="display: none;">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Reservas Activas</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info mb-2">
                    <small><i class="bi bi-info-circle"></i> <strong>Nota:</strong> El "Stock total en inventario" muestra el stock físico calculado desde movimientos de inventario (Compras - Ventas - Pérdidas). Este valor puede diferir del stock mostrado en la pantalla de productos si hay movimientos no registrados correctamente. La cantidad reservada es la que se aplicará a esta venta.</small>
                </div>
                <div id="reservasList"></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5>Detalle de Venta</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Producto</label>
                    <select id="productoSelect" class="form-select">
                        <option value="">Seleccione un producto</option>
                        @foreach (var producto in productos)
                        {
                            var stockActual = stock.ContainsKey(producto.ProductoId) ? stock[producto.ProductoId] : 0;
                            string stockTexto = $"Stock: {stockActual}";
                            
                            // Si es Vendedor y hay stock por sucursal, mostrar información adicional
                            if (esVendedor && stockPorSucursal != null && stockPorSucursal.ContainsKey(producto.ProductoId))
                            {
                                var stockSucursales = stockPorSucursal[producto.ProductoId];
                                var stockTotal = stockSucursales.Values.Sum();
                                stockTexto = $"Stock Total: {stockTotal}";
                            }
                            
                            var stockSucursalesJson = "";
                            if (esVendedor && stockPorSucursal != null && stockPorSucursal.ContainsKey(producto.ProductoId))
                            {
                                stockSucursalesJson = System.Text.Json.JsonSerializer.Serialize(stockPorSucursal[producto.ProductoId]);
                            }
                            
                            if (string.IsNullOrEmpty(stockSucursalesJson))
                            {
                                <option value="@producto.ProductoId" 
                                        data-precio="@producto.PrecioVenta" 
                                        data-stock="@stockActual"
                                        data-nombre="@producto.Nombre">
                                    @producto.Nombre - Q@(producto.PrecioVenta.ToString("N2")) (@stockTexto)
                                </option>
                            }
                            else
                            {
                                <option value="@producto.ProductoId" 
                                        data-precio="@producto.PrecioVenta" 
                                        data-stock="@stockActual"
                                        data-nombre="@producto.Nombre"
                                        data-stock-sucursales="@stockSucursalesJson">
                                    @producto.Nombre - Q@(producto.PrecioVenta.ToString("N2")) (@stockTexto)
                                </option>
                            }
                        }
                    </select>
                    @if (esVendedor)
                    {
                        <small class="text-muted">Los Vendedores pueden ver stock de todas las sucursales. El stock mostrado es el total consolidado.</small>
                    }
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Cantidad</label>
                        <input type="number" id="cantidadInput" class="form-control" min="1" value="1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Precio Unitario</label>
                        <input type="number" id="precioInput" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="button" class="btn btn-primary w-100" onclick="agregarProducto()">Agregar</button>
                    </div>
                </div>

                <table class="table" id="detalleTable">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Subtotal</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total:</th>
                            <th id="totalVenta">Q0.00</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <button type="submit" class="btn btn-success">Guardar Venta</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <script>
        let detalleVenta = [];
        let productosData = @Html.Raw(Json.Serialize(productos.Select(p => new { p.ProductoId, p.Nombre, p.PrecioVenta })));

        function agregarProducto() {
            const productoSelect = document.getElementById('productoSelect');
            const cantidadInput = document.getElementById('cantidadInput');
            const precioInput = document.getElementById('precioInput');

            const productoId = parseInt(productoSelect.value);
            const cantidad = parseInt(cantidadInput.value);
            const precio = parseFloat(precioInput.value || productoSelect.options[productoSelect.selectedIndex].dataset.precio);
            const nombre = productoSelect.options[productoSelect.selectedIndex].dataset.nombre;
            const stock = parseInt(productoSelect.options[productoSelect.selectedIndex].dataset.stock);

            if (!productoId || cantidad <= 0 || precio <= 0) {
                alert('Complete todos los campos correctamente');
                return;
            }

            if (cantidad > stock) {
                alert('Stock insuficiente');
                return;
            }

            const item = {
                ProductoId: productoId,
                Cantidad: cantidad,
                PrecioLista: precio,
                PrecioUnitario: precio
            };

            detalleVenta.push(item);
            actualizarTabla();
            
            productoSelect.value = '';
            cantidadInput.value = 1;
            precioInput.value = '';
        }

        function eliminarProducto(index) {
            detalleVenta.splice(index, 1);
            actualizarTabla();
        }

        function actualizarTabla() {
            const tbody = document.querySelector('#detalleTable tbody');
            tbody.innerHTML = '';

            let total = 0;
            detalleVenta.forEach((item, index) => {
                const subtotal = item.Cantidad * item.PrecioUnitario;
                total += subtotal;

                const row = tbody.insertRow();
                row.innerHTML = `
                    <td>${productosData.find(p => p.ProductoId === item.ProductoId)?.Nombre || ''}</td>
                    <td>${item.Cantidad}</td>
                    <td>Q${item.PrecioUnitario.toFixed(2)}</td>
                    <td>Q${subtotal.toFixed(2)}</td>
                    <td><button type="button" class="btn btn-sm btn-danger" onclick="eliminarProducto(${index})">Eliminar</button></td>
                `;
            });

            document.getElementById('totalVenta').textContent = `Q${total.toFixed(2)}`;
        }

        document.getElementById('productoSelect').addEventListener('change', function() {
            const precio = this.options[this.selectedIndex].dataset.precio;
            document.getElementById('precioInput').value = precio;
        });

        // Manejar cambio de cliente para cargar reservas activas
        async function cargarReservas(clienteId) {
            console.log('=== cargarReservas llamado con clienteId:', clienteId);
            const reservasSection = document.getElementById('reservasSection');
            const reservasList = document.getElementById('reservasList');

            if (!reservasSection || !reservasList) {
                console.error('ERROR: Elementos de reservas no encontrados');
                return;
            }

            if (!clienteId || clienteId === '' || clienteId === '0') {
                console.log('Sin cliente seleccionado, ocultando sección');
                reservasSection.style.display = 'none';
                reservasList.innerHTML = '';
                const reservaIdHidden = document.getElementById('reservaIdHidden');
                if (reservaIdHidden) reservaIdHidden.value = '';
                return;
            }

            try {
                console.log('Buscando reservas para cliente:', clienteId);
                reservasSection.style.display = 'block';
                reservasList.innerHTML = '<p class="text-muted"><i class="bi bi-hourglass-split"></i> Cargando reservas...</p>';
                
                const url = `/Ventas/ObtenerReservasActivas?clienteId=${clienteId}`;
                console.log('URL de petición:', url);
                
                const response = await fetch(url);
                console.log('Response status:', response.status);
                console.log('Response ok:', response.ok);
                
                if (!response.ok) {
                    console.error('Error HTTP:', response.statusText);
                    const errorText = await response.text();
                    console.error('Error detallado:', errorText);
                    reservasList.innerHTML = '<p class="text-danger">Error al cargar reservas: ' + response.statusText + '</p>';
                    return;
                }
                
                const reservas = await response.json();
                console.log('=== RESERVAS RECIBIDAS ===');
                console.log('Reservas:', reservas);
                console.log('Tipo:', typeof reservas);
                console.log('Es array?', Array.isArray(reservas));
                console.log('Cantidad:', reservas ? (Array.isArray(reservas) ? reservas.length : 'NO ES ARRAY') : 'NULL');

                if (reservas && Array.isArray(reservas) && reservas.length > 0) {
                    console.log('=== MOSTRANDO SECCIÓN DE RESERVAS ===');
                    reservasSection.style.display = 'block';
                    let html = '';
                    
                    reservas.forEach((reserva, index) => {
                        console.log(`Procesando reserva ${index}:`, reserva);
                        // Manejar tanto PascalCase como camelCase
                        const reservaId = reserva.ReservaId || reserva.reservaId;
                        const fechaHora = reserva.FechaHora || reserva.fechaHora;
                        const fechaVencimiento = reserva.FechaVencimiento || reserva.fechaVencimiento;
                        const detalles = reserva.Detalles || reserva.detalles || [];
                        
                        console.log(`Reserva #${reservaId} tiene ${detalles.length} detalles`);
                        
                        html += `
                            <div class="card mb-2 border-primary">
                                <div class="card-body">
                                    <h6 class="text-primary"><i class="bi bi-calendar-check"></i> Reserva #${reservaId} - ${new Date(fechaHora).toLocaleDateString('es-GT')}</h6>
                                    <p class="mb-2"><small><i class="bi bi-clock"></i> Vence: ${new Date(fechaVencimiento).toLocaleDateString('es-GT')}</small></p>
                                    <ul class="list-unstyled mb-2">`;
                        
                        detalles.forEach(detalle => {
                            // Manejar tanto PascalCase como camelCase
                            const productoNombre = detalle.ProductoNombre || detalle.productoNombre;
                            const cantidadReservada = detalle.CantidadReservada || detalle.cantidadReservada;
                            const precioVenta = detalle.PrecioVenta || detalle.precioVenta;
                            const stockDisponible = detalle.StockDisponible || detalle.stockDisponible;
                            
                            html += `
                                <li class="mb-1">
                                    <strong>${productoNombre}</strong> - 
                                    Cantidad reservada: <span class="badge bg-info">${cantidadReservada}</span> - 
                                    Precio: Q${parseFloat(precioVenta).toFixed(2)} - 
                                    <small class="text-muted">(Stock total en inventario: ${stockDisponible})</small>
                                </li>`;
                        });
                        
                        // Escapar correctamente los detalles para el atributo data
                        // Usar doble escape para evitar problemas con comillas
                        const detallesJson = JSON.stringify(detalles);
                        // Escapar comillas simples y dobles para HTML
                        const detallesEscapados = detallesJson
                            .replace(/\\/g, '\\\\')
                            .replace(/'/g, "&#39;")
                            .replace(/"/g, '&quot;');
                        
                        html += `
                                    </ul>
                                    <button type="button" 
                                            class="btn btn-sm btn-success" 
                                            onclick="asignarProductosReserva(${reservaId}, ${index})" 
                                            data-reserva-${index}='${detallesEscapados}'
                                            id="btn-reserva-${reservaId}-${index}">
                                        <i class="bi bi-check-circle"></i> Aplicar producto en reserva
                                    </button>
                                </div>
                            </div>`;
                    });
                    
                    reservasList.innerHTML = html;
                    console.log('=== HTML DE RESERVAS INSERTADO ===');
                } else {
                    console.log('No hay reservas activas o no es un array válido');
                    reservasSection.style.display = 'none';
                    reservasList.innerHTML = '';
                }
            } catch (error) {
                console.error('=== ERROR AL CARGAR RESERVAS ===', error);
                console.error('Stack trace:', error.stack);
                reservasList.innerHTML = '<p class="text-danger">Error: ' + error.message + '</p>';
            }
        }

        // Inicializar cuando el DOM esté listo
        function initReservas() {
            const clienteSelect = document.getElementById('clienteSelect');
            if (!clienteSelect) {
                console.error('clienteSelect no encontrado, reintentando...');
                setTimeout(initReservas, 100);
                return;
            }

            console.log('=== INICIALIZANDO RESERVAS ===');
            console.log('clienteSelect encontrado:', clienteSelect);
            console.log('Valor actual:', clienteSelect.value);
            
            clienteSelect.addEventListener('change', function() {
                console.log('=== CLIENTE CAMBIADO A:', this.value);
                cargarReservas(this.value);
            });

            // Cargar reservas si ya hay un cliente seleccionado al cargar la página
            if (clienteSelect.value) {
                console.log('Cliente pre-seleccionado:', clienteSelect.value);
                cargarReservas(clienteSelect.value);
            }
        }

        // Ejecutar inmediatamente si el DOM ya está listo, o esperar
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initReservas);
        } else {
            initReservas();
        }

        // Hacer la función global para que pueda ser llamada desde onclick
        window.asignarProductosReserva = function(reservaId, index) {
            console.log('=== asignarProductosReserva llamado ===');
            console.log('reservaId:', reservaId, 'index:', index);
            
            // Buscar el botón por ID primero (más confiable)
            let button = document.getElementById(`btn-reserva-${reservaId}-${index}`);
            
            // Si no se encuentra por ID, buscar por atributo data
            if (!button) {
                button = document.querySelector(`button[data-reserva-${index}]`);
            }
            
            // Si aún no se encuentra, buscar por onclick
            if (!button) {
                const buttons = document.querySelectorAll('button[onclick*="asignarProductosReserva"]');
                buttons.forEach(btn => {
                    const onclickAttr = btn.getAttribute('onclick') || '';
                    if (onclickAttr.includes(`asignarProductosReserva(${reservaId}, ${index})`)) {
                        button = btn;
                    }
                });
            }
            
            if (!button) {
                console.error('Botón no encontrado para reservaId:', reservaId, 'index:', index);
                alert('Error al obtener los productos de la reserva');
                return;
            }
            
            // Verificar si el botón ya fue usado
            if (button.disabled) {
                alert('Los productos de esta reserva ya fueron aplicados');
                return;
            }
            
            const detallesJson = button.getAttribute(`data-reserva-${index}`);
            console.log('Detalles JSON:', detallesJson);
            
            if (!detallesJson) {
                console.error('No se encontraron detalles en el atributo data');
                alert('Error: No se encontraron los productos de la reserva');
                return;
            }
            
            let detalles;
            try {
                // Decodificar entidades HTML primero
                const decodedJson = detallesJson
                    .replace(/&#39;/g, "'")
                    .replace(/&quot;/g, '"')
                    .replace(/\\\\/g, '\\');
                detalles = JSON.parse(decodedJson);
            } catch (e) {
                console.error('Error al parsear detalles:', e);
                console.error('JSON problemático:', detallesJson);
                alert('Error al procesar los productos de la reserva: ' + e.message);
                return;
            }
            
            if (!Array.isArray(detalles) || detalles.length === 0) {
                console.error('Detalles no es un array válido:', detalles);
                alert('Error: Los detalles de la reserva no son válidos o están vacíos');
                return;
            }
            
            console.log('Detalles parseados:', detalles);
            console.log('Cantidad de detalles:', detalles.length);
            
            // Agregar productos al detalle (NO limpiar los existentes)
            let productosAgregados = 0;
            detalles.forEach(detalle => {
                // Manejar tanto PascalCase como camelCase
                const productoId = detalle.ProductoId || detalle.productoId;
                const cantidadReservada = detalle.CantidadReservada || detalle.cantidadReservada;
                const precioVenta = detalle.PrecioVenta || detalle.precioVenta;
                
                console.log('Procesando producto:', { productoId, cantidadReservada, precioVenta });
                
                if (!productoId || !cantidadReservada || !precioVenta) {
                    console.warn('Datos incompletos para producto:', detalle);
                    return;
                }
                
                // Verificar si el producto ya existe en el detalle
                const existe = detalleVenta.findIndex(item => item.ProductoId === productoId);
                
                if (existe >= 0) {
                    // Si ya existe, sumar la cantidad
                    detalleVenta[existe].Cantidad += parseInt(cantidadReservada);
                    console.log('Producto existente actualizado:', detalleVenta[existe]);
                } else {
                    // Agregar nuevo producto
                    const item = {
                        ProductoId: parseInt(productoId),
                        Cantidad: parseInt(cantidadReservada),
                        PrecioLista: parseFloat(precioVenta),
                        PrecioUnitario: parseFloat(precioVenta)
                    };
                    detalleVenta.push(item);
                    productosAgregados++;
                    console.log('Producto agregado:', item);
                }
            });
            
            console.log('detalleVenta después de asignar:', detalleVenta);
            console.log('Total productos en detalle:', detalleVenta.length);
            
            // Actualizar el campo oculto de ReservaId
            const reservaIdHidden = document.getElementById('reservaIdHidden');
            if (reservaIdHidden) {
                reservaIdHidden.value = reservaId;
                console.log('ReservaId guardado en hidden:', reservaId);
            }
            
            // Actualizar la tabla visual
            actualizarTabla();
            console.log('Tabla actualizada');
            
            // Deshabilitar el botón después de aplicar para evitar aplicar dos veces
            button.disabled = true;
            button.classList.remove('btn-success');
            button.classList.add('btn-secondary');
            button.innerHTML = '<i class="bi bi-check-circle-fill"></i> Productos aplicados';
            
            // Mostrar mensaje de confirmación
            alert(`✓ Se agregaron ${productosAgregados} producto(s) de la reserva #${reservaId} al detalle de venta.\n\nLos productos de esta reserva quedarán marcados como ocupados al completar la venta.`);
        };

        document.getElementById('ventaForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            if (detalleVenta.length === 0) {
                alert('Debe agregar al menos un producto');
                return;
            }

            // Crear inputs ocultos para cada item del detalle
            detalleVenta.forEach((item, index) => {
                const inputProductoId = document.createElement('input');
                inputProductoId.type = 'hidden';
                inputProductoId.name = `Detalle[${index}].ProductoId`;
                inputProductoId.value = item.ProductoId;
                this.appendChild(inputProductoId);

                const inputCantidad = document.createElement('input');
                inputCantidad.type = 'hidden';
                inputCantidad.name = `Detalle[${index}].Cantidad`;
                inputCantidad.value = item.Cantidad;
                this.appendChild(inputCantidad);

                const inputPrecioLista = document.createElement('input');
                inputPrecioLista.type = 'hidden';
                inputPrecioLista.name = `Detalle[${index}].PrecioLista`;
                inputPrecioLista.value = item.PrecioLista;
                this.appendChild(inputPrecioLista);

                const inputPrecioUnitario = document.createElement('input');
                inputPrecioUnitario.type = 'hidden';
                inputPrecioUnitario.name = `Detalle[${index}].PrecioUnitario`;
                inputPrecioUnitario.value = item.PrecioUnitario;
                this.appendChild(inputPrecioUnitario);
            });

            this.submit();
        });
    </script>
}