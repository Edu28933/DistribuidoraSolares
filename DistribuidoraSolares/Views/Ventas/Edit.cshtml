@model DistribuidoraSolares.Models.Venta
@using System.Text.Json
@{
    ViewData["Title"] = "Editar Venta";
    var productos = ViewBag.Productos as List<DistribuidoraSolares.Models.Producto> ?? new List<DistribuidoraSolares.Models.Producto>();
    var clientes = ViewBag.Clientes as List<DistribuidoraSolares.Models.Cliente> ?? new List<DistribuidoraSolares.Models.Cliente>();
    var metodosPago = ViewBag.MetodosPago as List<DistribuidoraSolares.Models.MetodoPago> ?? new List<DistribuidoraSolares.Models.MetodoPago>();
    var stock = ViewBag.Stock as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container">
    <h1>Editar Venta #@Model.VentaId</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form id="ventaForm" method="post" asp-action="Edit" asp-route-id="@Model.VentaId">
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Cliente (Opcional)</label>
                <select name="ClienteId" id="clienteSelect" class="form-select">
                    <option value="">Cliente General</option>
                    @foreach (var cliente in clientes)
                    {
                        <option value="@cliente.ClienteId" selected="@(Model.ClienteId == cliente.ClienteId)">@cliente.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Método de Pago</label>
                <select name="MetodoPagoId" class="form-select" required>
                    <option value="">Seleccione método de pago</option>
                    @foreach (var metodo in metodosPago)
                    {
                        <option value="@metodo.MetodoPagoId" selected="@(Model.MetodoPagoId == metodo.MetodoPagoId)">@metodo.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Tipo de Venta</label>
                <select name="TipoVenta" class="form-select" required>
                    <option value="NORMAL" selected="@(Model.TipoVenta == "NORMAL")">Venta Normal</option>
                    <option value="PERDIDA" selected="@(Model.TipoVenta == "PERDIDA")">Pérdida</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Observación de Edición <span class="text-danger">*</span></label>
            <textarea name="observacionEdicion" class="form-control" rows="3" required placeholder="Explique por qué está editando esta venta (ej: producto agregado por error, cantidad incorrecta, etc.)"></textarea>
            <small class="form-text text-muted">Este campo es obligatorio para rastrear los cambios realizados</small>
        </div>

        <input type="hidden" name="UsuarioId" value="@ViewBag.UsuarioId" />
        <input type="hidden" name="DescuentoManual" value="@Model.DescuentoManual" />

        <div class="card mb-3">
            <div class="card-header">
                <h5>Detalle de Venta</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Producto</label>
                    <select id="productoSelect" class="form-select">
                        <option value="">Seleccione un producto</option>
                        @foreach (var producto in productos)
                        {
                            var stockActual = stock.ContainsKey(producto.ProductoId) ? stock[producto.ProductoId] : 0;
                            <option value="@producto.ProductoId" 
                                    data-precio="@producto.PrecioVenta" 
                                    data-stock="@stockActual"
                                    data-nombre="@producto.Nombre">
                                @producto.Nombre - Q@(producto.PrecioVenta.ToString("N2")) (Stock: @stockActual)
                            </option>
                        }
                    </select>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Cantidad</label>
                        <input type="number" id="cantidadInput" class="form-control" min="1" value="1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Precio Unitario</label>
                        <input type="number" id="precioInput" class="form-control" step="0.01" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="button" class="btn btn-primary w-100" onclick="agregarProducto()">Agregar</button>
                    </div>
                </div>

                <table class="table" id="detalleTable">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Subtotal</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total:</th>
                            <th id="totalVenta">Q0.00</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <script>
        // Inicializar detalleVenta con los datos existentes de la venta
        @{
            string detallesJson;
            if (Model.Detalles != null && Model.Detalles.Any())
            {
                detallesJson = System.Text.Json.JsonSerializer.Serialize(
                    Model.Detalles.Select(d => new { d.ProductoId, d.Cantidad, d.PrecioLista, d.PrecioUnitario })
                );
            }
            else
            {
                detallesJson = "[]";
            }
        }
        let detalleVenta = @Html.Raw(detallesJson);
        let productosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productos.Select(p => new { p.ProductoId, p.Nombre, p.PrecioVenta })));

        console.log('Detalles cargados:', detalleVenta); // Debug
        console.log('Productos disponibles:', productosData); // Debug

        function agregarProducto() {
            const productoSelect = document.getElementById('productoSelect');
            const cantidadInput = document.getElementById('cantidadInput');
            const precioInput = document.getElementById('precioInput');

            const productoId = parseInt(productoSelect.value);
            const cantidad = parseInt(cantidadInput.value);
            const precio = parseFloat(precioInput.value || productoSelect.options[productoSelect.selectedIndex].dataset.precio);
            const stock = parseInt(productoSelect.options[productoSelect.selectedIndex].dataset.stock);

            if (!productoId || cantidad <= 0 || precio <= 0) {
                alert('Complete todos los campos correctamente');
                return;
            }

            if (cantidad > stock) {
                alert('Stock insuficiente');
                return;
            }

            const item = {
                ProductoId: productoId,
                Cantidad: cantidad,
                PrecioLista: precio,
                PrecioUnitario: precio
            };

            detalleVenta.push(item);
            actualizarTabla();
            
            productoSelect.value = '';
            cantidadInput.value = 1;
            precioInput.value = '';
        }

        function eliminarProducto(index) {
            detalleVenta.splice(index, 1);
            actualizarTabla();
        }

        function actualizarTabla() {
            const tbody = document.querySelector('#detalleTable tbody');
            tbody.innerHTML = '';

            let total = 0;
            detalleVenta.forEach((item, index) => {
                const subtotal = item.Cantidad * item.PrecioUnitario;
                total += subtotal;

                const row = tbody.insertRow();
                row.innerHTML = `
                    <td>${productosData.find(p => p.ProductoId === item.ProductoId)?.Nombre || ''}</td>
                    <td>${item.Cantidad}</td>
                    <td>Q${item.PrecioUnitario.toFixed(2)}</td>
                    <td>Q${subtotal.toFixed(2)}</td>
                    <td><button type="button" class="btn btn-sm btn-danger" onclick="eliminarProducto(${index})">Eliminar</button></td>
                `;
            });

            document.getElementById('totalVenta').textContent = `Q${total.toFixed(2)}`;
        }

        document.getElementById('productoSelect').addEventListener('change', function() {
            const precio = this.options[this.selectedIndex].dataset.precio;
            document.getElementById('precioInput').value = precio;
        });

        // Inicializar tabla con datos existentes
        actualizarTabla();

        document.getElementById('ventaForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            if (detalleVenta.length === 0) {
                alert('Debe agregar al menos un producto');
                return;
            }

            // Crear inputs ocultos para cada item del detalle
            detalleVenta.forEach((item, index) => {
                const inputProductoId = document.createElement('input');
                inputProductoId.type = 'hidden';
                inputProductoId.name = `Detalle[${index}].ProductoId`;
                inputProductoId.value = item.ProductoId;
                this.appendChild(inputProductoId);

                const inputCantidad = document.createElement('input');
                inputCantidad.type = 'hidden';
                inputCantidad.name = `Detalle[${index}].Cantidad`;
                inputCantidad.value = item.Cantidad;
                this.appendChild(inputCantidad);

                const inputPrecioLista = document.createElement('input');
                inputPrecioLista.type = 'hidden';
                inputPrecioLista.name = `Detalle[${index}].PrecioLista`;
                inputPrecioLista.value = item.PrecioLista;
                this.appendChild(inputPrecioLista);

                const inputPrecioUnitario = document.createElement('input');
                inputPrecioUnitario.type = 'hidden';
                inputPrecioUnitario.name = `Detalle[${index}].PrecioUnitario`;
                inputPrecioUnitario.value = item.PrecioUnitario;
                this.appendChild(inputPrecioUnitario);
            });

            this.submit();
        });
    </script>
}
