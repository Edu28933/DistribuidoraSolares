@{
    ViewData["Title"] = "Reporte: Stock Bajo";
    var stockBajo = ViewBag.StockBajo as List<DistribuidoraSolares.Models.StockActual> ?? new List<DistribuidoraSolares.Models.StockActual>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Reporte: Stock Bajo</h1>
        <div>
            <a asp-action="Index" class="btn btn-secondary">Volver a Reportes</a>
            <button onclick="window.print()" class="btn btn-primary">Imprimir</button>
        </div>
    </div>

    <div class="alert alert-warning">
        <strong>⚠️ Atención:</strong> Los siguientes productos tienen stock igual o por debajo del mínimo establecido.
    </div>

    @if (stockBajo.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th class="text-end">Stock Actual</th>
                        <th class="text-end">Stock Mínimo</th>
                        <th class="text-end">Diferencia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in stockBajo)
                    {
                        var diferencia = item.StockMinimo - item.Stock;
                        <tr class="@(item.Stock == 0 ? "table-danger" : "")">
                            <td>@item.Codigo</td>
                            <td>@item.Nombre</td>
                            <td class="text-end">
                                <span class="badge @(item.Stock == 0 ? "bg-danger" : "bg-warning")">
                                    @item.Stock
                                </span>
                            </td>
                            <td class="text-end">@item.StockMinimo</td>
                            <td class="text-end">
                                <strong class="text-danger">-@diferencia</strong>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-success">
            <p>✅ Todos los productos tienen stock por encima del mínimo establecido.</p>
        </div>
    }
</div>

<style>
    @@media print {
        .btn { display: none !important; }
    }
</style>
