@model List<DistribuidoraSolares.Models.ReporteProductoVendido>
@{
    ViewData["Title"] = "Reporte: Productos Más Vendidos";
    var fechaDesde = ViewBag.FechaDesde as DateTime?;
    var fechaHasta = ViewBag.FechaHasta as DateTime?;
    var topN = ViewBag.TopN as int? ?? 10;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Reporte: Productos Más Vendidos</h1>
        <div>
            <a asp-action="Index" class="btn btn-secondary">Volver a Reportes</a>
            <button onclick="window.print()" class="btn btn-primary">Imprimir</button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Filtros Aplicados</h5>
        </div>
        <div class="card-body">
            <p><strong>Período:</strong> @(fechaDesde?.ToString("dd/MM/yyyy") ?? "Desde el inicio") - @(fechaHasta?.ToString("dd/MM/yyyy") ?? "Hasta hoy")</p>
            <p><strong>Top:</strong> @topN productos</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Producto</th>
                        <th class="text-end">Cantidad Vendida</th>
                        <th class="text-end">Total Vendido</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int posicion = 1;
                    }
                    @foreach (var producto in Model)
                    {
                        <tr>
                            <td>@posicion</td>
                            <td>@producto.ProductoNombre</td>
                            <td class="text-end">@producto.CantidadVendida</td>
                            <td class="text-end"><strong>Q@(producto.TotalVendido.ToString("N2"))</strong></td>
                        </tr>
                        posicion++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>No hay productos vendidos en el período seleccionado.</p>
        </div>
    }
</div>

<style>
    @@media print {
        .btn { display: none !important; }
    }
</style>
